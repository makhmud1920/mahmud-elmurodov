# --- Muhit ---
# development | production
ENVIRONMENT=development

# --- Xavfsizlik kaliti (MAJBURIY) ---
# Yangi kalit yaratish:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT tokenning amal qilish muddati (daqiqada)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Admin (seed skript uchun) ---
# Kamida 12 belgili kuchli parol qo'ying!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Cookie ---
# Lokalda http: false | Productionda https: true
COOKIE_SECURE=false
# lax (tavsiya) | strict | none
COOKIE_SAMESITE=lax

# --- CORS (frontend manzillari, vergul bilan) ---
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (ixtiyoriy) ---
# Bo'sh qoldirilsa lokal SQLite ishlatiladi.
# DATABASE_URL=postgresql://user:parol@host:5432/dbname
